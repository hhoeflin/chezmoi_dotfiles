# Ensure profile is loaded for non-login shells
if [[ ! -v __PROFILE_LOADED ]]; then
    source /etc/profile
    source ${HOME}/.profile
fi

# Source all shell files in ~/profile.d
if [[ -d "${HOME}/profile.d" ]]; then
    for f in "${HOME}/profile.d/"*.sh; do
        [ -r "$f" ] && [ -f "$f" ] && source "$f"
    done
fi

source ~/.shell_common
source ~/.shell_interactive

# Zsh-specific settings
setopt INC_APPEND_HISTORY SHARE_HISTORY EXTENDED_GLOB CHECK_JOBS
export HISTSIZE=10000

# Home/End key bindings
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[OH" beginning-of-line
bindkey "^[OF" end-of-line
bindkey "^[[1~" beginning-of-line
bindkey "^[[4~" end-of-line